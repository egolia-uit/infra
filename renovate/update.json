{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "branchPrefix": "egolia-renovate-update/",
  "extends": ["github>egolia-uit/renovate-config"],
  "automerge": true,
  "platformAutomerge": true,
  "platformCommit": "enabled",
  "automergeType": "branch",
  "ignoreTests": true,
  "enabledManagers": ["kustomize"],
  "kustomize": {
    "managerFilePatterns": ["(^|/)kustomization\\.ya?ml$"],
    "packageRules": [
      {
        "matchPackageNames": ["/^ghcr\\.io/egolia-uit/.+/"],
        "versioning": "regex:^dev-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
      },
      {
        "groupName": "Update egolia dev images",
        "matchPackageNames": ["/^ghcr\\.io/egolia-uit/.+/"],
        "matchUpdateTypes": ["major", "minor", "patch"]
      },
      {
        "matchPackageNames": ["*", "!/^ghcr\\.io/egolia-uit/.+/"],
        "enabled": false
      }
    ]
  }
}
